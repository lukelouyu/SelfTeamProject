@startuml
title UniEnable Architecture

skinparam componentStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultTextAlignment center

actor User

package "Application" {
  [UniEnable] as Entry
  [ApplicationRunner] as Runner
  [CommandConfirmationHandler] as Confirm
  [CommandTransactionExecutor] as Transaction
}

package "User interface" {
  [Ui and formatters] as UI
}

package "Command processing" {
  [CommandDispatcher] as Dispatcher
  [Domain parsers] as Parsers
  [Commands] as Commands
}

package "Business logic" {
  [ActivityManager] as ActivityLogic
  [TopicManager] as TopicLogic
  [FacilityManager] as FacilityLogic
  [ConnectionManager] as ConnectionLogic
  [RecurrencePlanner] as RecurLogic
  [AccessibleRouteGraphFactory] as RouteLogic
  [DashboardService] as DashboardLogic
  [TimetableService] as TimetableLogic
  [PreferenceManager] as PreferenceLogic
  [RecommendationManager] as RecommendState
  [RecommendationService] as RecommendLogic
}

package "Domain model" {
  [Activities and topics] as ActivityModel
  [Recurrence model] as RecurModel
  [Accessibility records] as AccessModel
  [Timetable view model] as TimetableModel
  [Preference profile] as PreferenceModel
  [Recommendation proposal model] as RecommendModel
}

package "Persistence" {
  [Storage] as Storage
  [AcademicCalendarStorage] as CalendarStorage
  database "Local text files" as Files
}

User --> Entry : starts
Entry --> Runner
Runner --> UI
Runner --> Confirm
Runner --> Transaction
Confirm --> UI
Runner --> Dispatcher
Dispatcher --> Parsers
Parsers --> Commands : creates
Transaction --> Commands : executes
Transaction --> ActivityLogic : snapshots/restores
Transaction --> TopicLogic : snapshots/restores
Transaction --> PreferenceLogic : snapshots/restores
Commands --> ActivityLogic
Commands --> TopicLogic
Commands --> FacilityLogic
Commands --> ConnectionLogic
Commands --> RouteLogic
RouteLogic --> FacilityLogic
RouteLogic --> ConnectionLogic
Commands --> DashboardLogic
DashboardLogic --> ActivityLogic
Commands --> TimetableLogic
Commands --> PreferenceLogic
Commands --> RecommendState
Commands --> RecommendLogic
TimetableLogic --> ActivityLogic
TimetableLogic --> TimetableModel
PreferenceLogic --> PreferenceModel
RecommendLogic --> ActivityLogic
RecommendLogic --> PreferenceLogic
RecommendLogic --> RecommendModel
RecommendLogic --> TimetableLogic
RecommendLogic --> DashboardLogic
RecommendState --> RecommendModel
Parsers --> RecurLogic
ActivityLogic --> ActivityModel
TopicLogic --> ActivityModel
RecurLogic --> ActivityLogic
RecurLogic --> RecurModel
FacilityLogic --> AccessModel
ConnectionLogic --> AccessModel
Runner --> Storage
Storage --> ActivityModel
Storage --> AccessModel
Storage --> PreferenceModel
Storage --> Files
CalendarStorage --> Files : reads only
Parsers --> CalendarStorage
UI --> User : output

@enduml
