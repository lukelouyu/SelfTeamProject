@startuml
title Planning Recurring Activities

skinparam shadowing false
hide footbox
autonumber

actor User
participant ApplicationRunner as Runner
participant CommandDispatcher as Dispatcher
participant RecurCommandParser as Parser
participant ActivityManager as Manager
participant ClassSchedulePolicy as Policy
participant WeekSpecificationParser as WeekParser
participant AcademicCalendarStorage as CalendarStorage
participant RecurrencePlanner as Planner
participant ActivityConflictChecker as Checker

User -> Runner : recur 1 week 1 to 6
Runner -> Dispatcher : dispatch(input, now)
Dispatcher -> Parser : parse(manager, now, arguments)
Parser -> Manager : getById(1)
Manager --> Parser : source Activity
Parser -> Policy : isClassSchedule(source)
Policy --> Parser : true
Parser -> WeekParser : parse("1 to 6")
WeekParser --> Parser : requestedWeeks
opt first recur command in this run
  Parser -> CalendarStorage : load(calendarFile)
  CalendarStorage --> Parser : AcademicCalendar
end
Parser -> Planner : plan(source, weeks, calendar, manager, now)
Planner -> Planner : find source week; require it in request
loop each requested week
  Planner -> Planner : resolve matching weekday
  alt is the source's own date
    Planner -> Planner : record SkippedOccurrence
  else target date before now, or today at/before now's time
    Planner -> Planner : requireNotPast(week, targetDate, sourceStartTime, now)
    Planner --> Parser : throws InvalidActivityException\n(whole plan rejected, nothing recorded)
  else no-class date, or identical occurrence already exists
    Planner -> Planner : record SkippedOccurrence
  else new occurrence
    Planner -> Manager : checkNoConflicts(candidate, -1)
    Manager -> Checker : checkNoConflicts(candidate, -1, activities)
    Checker --> Manager : accepted
    Manager --> Planner
    Planner -> Planner : record PlannedOccurrence
  end
end
Planner --> Parser : immutable RecurrencePlan
Parser --> Dispatcher : RecurCommand(manager, plan)
Dispatcher --> Runner : command ready for preview

@enduml
