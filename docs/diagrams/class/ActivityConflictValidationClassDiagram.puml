@startuml
title Activity Conflict Validation

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
hide circle
hide empty members

class ActivityManager {
  - activities : List<Activity>
  - conflictChecker : ActivityConflictChecker
  - nextId : int
  + add(activity : Activity) : void
  + replace(id : int, newActivity : Activity) : void
  + checkNoConflicts(candidate : Activity, excludeId : int) : void
  + addAllAtomically(candidates : List<? extends Activity>) : void
  + getNextId() : int
}

class ActivityConflictChecker <<package-private, stateless>> {
  ~ ActivityConflictChecker()
  ~ checkNoConflicts(candidate : Activity, excludedActivityId : int, activitiesToCheck : List<? extends Activity>) : void
  - isDuplicate(candidate : Activity, excludedActivityId : int, activitiesToCheck : List<? extends Activity>) : boolean
  - {static} effectiveInterval(activity : Activity) : Optional<ScheduledInterval>
  - findOverlap(candidateInterval : ScheduledInterval, excludedActivityId : int, activitiesToCheck : List<? extends Activity>) : Activity
}

class ScheduledInterval <<record, private>> {
  - date : LocalDate
  - start : LocalTime
  - end : LocalTime
}

abstract class Activity
class FixedActivity
class FlexibleActivity
class DuplicateActivityException

ActivityManager "1" *-- "1" ActivityConflictChecker
ActivityManager "1" o-- "0..*" Activity
ActivityConflictChecker ..> Activity
ActivityConflictChecker ..> FixedActivity
ActivityConflictChecker ..> FlexibleActivity
ActivityConflictChecker ..> DuplicateActivityException : throws
ActivityConflictChecker "1" ..> "0..2" ScheduledInterval : derives per check

note bottom of ActivityConflictChecker
  Checks exact scheduling duplicates first.
  Then computes each side's effective occupied
  interval: a FixedActivity always has one; a
  FlexibleActivity only once hasAdoptedPlacement()
  is true (adopted start/end, not the earliest/
  latest window); an unadopted FlexibleActivity
  has none and can never conflict. Two occupied
  intervals overlap when
  existing.start < candidate.end and
  candidate.start < existing.end.
  The first overlap in list order is reported.
end note

note bottom of ActivityManager
  Manager owns permanent IDs and mutation.
  Batch candidates are validated against a
  temporary list before the real list changes.
end note

@enduml
