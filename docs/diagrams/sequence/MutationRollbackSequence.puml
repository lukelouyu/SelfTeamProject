@startuml
title Save Failure and Mutation Rollback

skinparam shadowing false
hide footbox
autonumber

actor User
participant ApplicationRunner as Runner
participant CommandTransactionExecutor as Transaction
participant "CommandTransactionExecutor.Execution" as Execution
participant "Mutating Command" as Command
participant ActivityManager
participant TopicManager
participant PreferenceManager
participant Storage
participant Ui

Runner -> Command : hasStateChange()
Command --> Runner : true
Runner -> Transaction : execute(command)
Transaction -> Transaction : capture deep Snapshot
Transaction -> Command : execute()
alt command execution fails after mutation
  Command --> Transaction : throw exception
  Transaction -> ActivityManager : restoreState(activities, nextId, order)
  Transaction -> TopicManager : loadAll(topics)
  Transaction -> PreferenceManager : setProfile(preferences)
  Transaction --> Runner : rethrow exception
  Runner -> Ui : show command error
  Ui --> User : failure; no partial mutation
else command execution succeeds
  Command --> Transaction : CommandResult
  Transaction --> Runner : Execution(result, snapshot)
  Runner -> Storage : saveAll(activities, topics, order, preferences)
  Storage -> Storage : stage four temporary files
  Storage -> Storage : commit activities, topics, settings, preferences
  alt a file commit fails, or saveAll throws an unexpected RuntimeException
    Storage -> Storage : restore prior file states (if a commit failure)
    Storage --> Runner : throw StorageException / RuntimeException
    Runner -> Execution : rollback()
    Execution -> ActivityManager : restoreState(activities, nextId, order)
    Execution -> TopicManager : loadAll(topics)
    Execution -> PreferenceManager : setProfile(preferences)
    Runner -> Ui : show storage error
    Ui --> User : failure; no success feedback
    note over Runner
      hasUnsavedChanges stays true so bye retries
      and never falsely claims the change was saved.
    end note
  else all commits succeed
    Storage --> Runner : saved
    Runner -> Ui : show success feedback
    Ui --> User : success
  end
end

@enduml
