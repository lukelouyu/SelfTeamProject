@startuml
title Deterministic Schedule Recommendation (recommend)

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
hide circle
hide empty members

class RecommendCommandParser {
  + parse(activityManager : ActivityManager, preferenceManager : PreferenceManager,
      recommendationManager : RecommendationManager, now : LocalDateTime, args : String) : Command
}

abstract class Command {
  + getEffect() : CommandEffect
  + hasStateChange() : boolean
}

abstract class ReadOnlyCommand

enum CommandEffect {
  READ_ONLY
  MUTATING
}

class RecommendGenerateCommand <<Command>> {
  - activityManager : ActivityManager
  - preferenceManager : PreferenceManager
  - recommendationManager : RecommendationManager
  - now : LocalDateTime
  - date : LocalDate
  + execute() : CommandResult
}

class RecommendViewCommand <<Command>> {
  - activityManager : ActivityManager
  - recommendationManager : RecommendationManager
  - now : LocalDateTime
  + execute() : CommandResult
}

class RecommendCancelCommand <<Command>> {
  - recommendationManager : RecommendationManager
  + execute() : CommandResult
}

class RecommendAdoptCommand <<Command, Confirmable>> {
  - activityManager : ActivityManager
  - proposal : RecommendationProposal
  + getConfirmation() : Confirmation
  + execute() : CommandResult
}

class RecommendationManager {
  - proposal : RecommendationProposal
  + setProposal(proposal : RecommendationProposal) : void
  + getProposal() : Optional<RecommendationProposal>
  + hasProposal() : boolean
  + clear() : void
}

class RecommendationService <<static>> {
  + {static} recommendThisWeek(activityManager : ActivityManager, preferences : PreferenceProfile,
      now : LocalDateTime) : RecommendationProposal
  + {static} recommendDate(activityManager : ActivityManager, preferences : PreferenceProfile,
      date : LocalDate) : RecommendationProposal
  + {static} applyPreview(activities : List<Activity>,
      proposal : RecommendationProposal) : List<Activity>
  + {static} buildPreview(activityManager : ActivityManager,
      proposal : RecommendationProposal, now : LocalDateTime) : RecommendationPreview
  + {static} hasOutOfPreferredRangePlacement(proposal : RecommendationProposal,
      preferences : PreferenceProfile) : boolean
}

class ActivityCopyFactory <<static>>

class RecommendationPreview <<immutable>> {
  - proposal : RecommendationProposal
  - timetable : TimetableView
  - dashboard : DashboardSummary
}

class RecommendationFormatter <<static>> {
  + {static} formatPreview(preview : RecommendationPreview) : String
  + {static} formatAdoptSuccess(proposal : RecommendationProposal) : String
  + {static} formatCancel() : String
  + {static} formatMissingProposal() : String
}

class RecommendationProposal <<immutable>> {
  - timetablePeriod : TimetablePeriod
  - dashboardPeriod : DashboardPeriod
  - placements : List<RecommendedPlacement>
  - unscheduledActivityIds : List<Integer>
}

class RecommendedPlacement <<immutable>>

class ActivityManager <<read-only for generate>>
class PreferenceManager
class PreferenceProfile <<immutable>>
class FlexibleActivity
class TimetableService <<static>>
class DashboardService <<static>>
class TimetableView <<immutable>>
class DashboardSummary <<immutable>>

RecommendCommandParser ..> RecommendGenerateCommand : creates
RecommendCommandParser ..> RecommendViewCommand : creates
RecommendCommandParser ..> RecommendCancelCommand : creates
RecommendCommandParser ..> RecommendAdoptCommand : creates
RecommendCommandParser ..> RecommendationManager : reads active proposal
RecommendCommandParser ..> PreferenceManager : reads current profile
RecommendCommandParser ..> RecommendationService : hasElapsedPlacement(),\nhasOutOfPreferredRangePlacement()

Command --> CommandEffect
Command <|-- ReadOnlyCommand
ReadOnlyCommand <|-- RecommendGenerateCommand
ReadOnlyCommand <|-- RecommendViewCommand
ReadOnlyCommand <|-- RecommendCancelCommand
Command <|-- RecommendAdoptCommand

RecommendGenerateCommand --> RecommendationService : build proposal,\nthen buildPreview()
RecommendGenerateCommand --> RecommendationManager : store proposal
RecommendGenerateCommand --> RecommendationFormatter : formatPreview(preview)
RecommendGenerateCommand --> ActivityManager
RecommendGenerateCommand --> PreferenceManager

RecommendViewCommand --> RecommendationManager : read proposal
RecommendViewCommand --> RecommendationService : buildPreview()
RecommendViewCommand --> RecommendationFormatter : formatPreview(preview)
RecommendViewCommand --> ActivityManager

RecommendCancelCommand --> RecommendationManager : clear()
RecommendCancelCommand --> RecommendationFormatter : formatCancel()

RecommendAdoptCommand --> ActivityManager : getById()
RecommendAdoptCommand ..> FlexibleActivity : setAdoptedStartTime()
RecommendAdoptCommand --> RecommendationFormatter : formatAdoptSuccess()

RecommendationService ..> ActivityManager : reads getAll()
RecommendationService ..> PreferenceProfile : reads
RecommendationService ..> RecommendationProposal : builds
RecommendationService ..> RecommendedPlacement : builds
RecommendationService ..> FlexibleActivity : reads/copies/adopts preview
RecommendationService ..> ActivityCopyFactory : copies preview activities
RecommendationService ..> TimetableService : build() (via buildPreview)
RecommendationService ..> DashboardService : summarize() (via buildPreview,\nusing actual now)
RecommendationService ..> RecommendationPreview : builds
RecommendationFormatter ..> RecommendationPreview : reads only, no calculation
RecommendationProposal "1" *-- "0..*" RecommendedPlacement
RecommendationPreview "1" *-- "1" RecommendationProposal
RecommendationPreview "1" *-- "1" TimetableView
RecommendationPreview "1" *-- "1" DashboardSummary

note bottom of RecommendationManager
  Proposal state is in-memory only for the
  current application run. No history file
  or background schedule is persisted here.
end note

note bottom of RecommendationService
  Stateless and deterministic. Generation
  reads fixed activities, adopted flexible
  activities, preference data, and the
  target period, then returns one preview
  proposal without mutating stored state.
  Preferred start/end is a hard constraint
  enforced at generation (slot search never
  offers an out-of-range candidate), at
  proposal construction (final guard before
  a placement is added), and again at adopt
  time against the *current* profile via
  hasOutOfPreferredRangePlacement().
end note

@enduml
